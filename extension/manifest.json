{
  "manifest_version": 3,
  "name": "eCoSys C/O AutoFill Pro - Trợ lý Khai báo C/O",
  "version": "2.8.0",
  "description": "Tự động điền dữ liệu hồ sơ C/O từ file JSON hoặc Clipboard lên hệ thống eCoSys Bộ Công Thương (co.moit.gov.vn)",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://co.moit.gov.vn/*",
    "https://fileserverco.moit.gov.vn:444/*",
    "http://localhost:14005/*",
    "http://127.0.0.1:14005/*",
    "https://localhost:14405/*",
    "https://127.0.0.1:14405/*",
    "http://127.0.0.1:14008/*",
    "http://localhost:14008/*",
    "http://127.0.0.1:14009/*",
    "http://localhost:14009/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://co.moit.gov.vn/*"],
      "js": ["injected_proxy.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://co.moit.gov.vn/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected_proxy.js"],
      "matches": ["https://co.moit.gov.vn/*"]
    }
  ]
}